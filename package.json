{
  "name": "fold-statusline",
  "version": "0.2.0",
  "description": "The Fold status line — a framed six-fact table for Claude Code: account, model, context, and the 5-hour, weekly and per-model limits",
  "type": "module",
  "bin": {
    "fold-statusline": "bin/cli.mjs"
  },
  "files": [
    "bin/cli.mjs",
    "statusline.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:font": "node font/build.mjs && python3 font/colorize.py",
    "deploy:font": "npm run build:font && cp font/FoldIcons.ttf ../fold/Sources/Fold/Resources/FoldIcons.ttf"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SamiAbi/fold-statusline.git"
  },
  "keywords": [
    "claude-code",
    "statusline",
    "terminal",
    "nerd-font",
    "fold"
  ],
  "author": "Sami Abishai",
  "license": "MIT",
  "devDependencies": {
    "svg2ttf": "^6.1.0",
    "svgicons2svgfont": "^15.0.1"
  }
}
